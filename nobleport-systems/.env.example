# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# Arbitrum One / NBPT / KUZO public configuration
ARBITRUM_CHAIN_ID=42161
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
NBPT_CONTRACT_ADDRESS=0xf72dfcab3889ecd409eeea2c21b7eebd6de79a47
KUZO_WALLET_ADDRESS=0x5108b22204f214352ad500719344E1C865B1dbDb
UNISWAP_CHAIN=arbitrum
UNISWAP_READ_ONLY=true
UNISWAP_TRANSACTION_PREPARATION=false
UNISWAP_AUTONOMOUS_TRADING=false

# Stephanie.ai voice output. Disabled by default until a Voicebox instance and
# authorized voice profile are configured and tested.
# For direct local (non-Docker) orchestrator runs, use http://127.0.0.1:17493.
STEPHANIE_VOICE_ENABLED=false
VOICEBOX_URL=http://host.docker.internal:17493
VOICEBOX_PROFILE=
VOICEBOX_CLIENT_ID=stephanie-ai
VOICEBOX_PERSONALITY=false
VOICEBOX_TIMEOUT_SECONDS=10

# Never place seed phrases or private keys in this file or repository.
